local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AvatarChangePanel"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 580, 0, 420)
mainFrame.Position = UDim2.new(0.5, -290, 0.5, -210)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
mainFrame.BorderColor3 = Color3.fromRGB(255, 69, 0)
mainFrame.BorderSizePixel = 4
mainFrame.Parent = screenGui

local headerFrame = Instance.new("Frame")
headerFrame.Name = "HeaderFrame"
headerFrame.Size = UDim2.new(1, 0, 0, 60)
headerFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
headerFrame.BorderSizePixel = 0
headerFrame.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -140, 1, 0)
titleLabel.Position = UDim2.new(0, 70, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "Avatar Changes"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.TextSize = 26
titleLabel.Parent = headerFrame

local leftImage = Instance.new("ImageLabel")
leftImage.Size = UDim2.new(0, 50, 0, 50)
leftImage.Position = UDim2.new(0, 10, 0, 5)
leftImage.BackgroundTransparency = 1
leftImage.Image = "rbxassetid://125494725096524"
leftImage.Parent = headerFrame

local rightImage = Instance.new("ImageLabel")
rightImage.Size = UDim2.new(0, 50, 0, 50)
rightImage.Position = UDim2.new(1, -60, 0, 5)
rightImage.BackgroundTransparency = 1
rightImage.Image = "rbxassetid://125494725096524"
rightImage.Parent = headerFrame

local divider = Instance.new("Frame")
divider.Size = UDim2.new(1, 0, 0, 3)
divider.Position = UDim2.new(0, 0, 1, 0)
divider.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
divider.BorderSizePixel = 0
divider.Parent = headerFrame

local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

headerFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

headerFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(1, -20, 1, -75)
scrollFrame.Position = UDim2.new(0, 10, 0, 75)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 1400)
scrollFrame.ScrollBarThickness = 6
scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(255, 69, 0)
scrollFrame.Parent = mainFrame

local uiGrid = Instance.new("UIGridLayout")
uiGrid.CellSize = UDim2.new(0, 85, 0, 55)
uiGrid.CellPadding = UDim2.new(0, 8, 0, 8)
uiGrid.SortOrder = Enum.SortOrder.LayoutOrder
uiGrid.Parent = scrollFrame

local buttonList = {
	"Head Shake", "Mesh Disco", "Armless", "Plane Arms", "Dev Uzi", "Floating Pad F3X",
	"Chicken Arms", "Disco Character", "Mutation", "Neon Disco", "Btools", "Barrier For Torso",
	"Wall Walking", "Special Thing [Shirt]", "Special Thing [Pants]", "Fakelag", "Knife", "F3X",
	"Seeing Hand", "John Doe", "Chara Ultimate", "Thomas", "SnowBall [HD ADMIN]", "AK47",
	"Steve", "Goner", "Szemtelen Mano", "Speeding Wall", "i0rb V2", "Pee",
	"Become 2sp00ks [HD ADMIN]", "Become 1x3x5x6 [HD ADMIN]", "Become E. Citizen [HD ADMIN]", "TPtool", "illuminati Laser", "KatanaV2 [HD ADMIN]",
	"Become Old c00lkidd skin", "Become Peter Griffin [HD ADMIN]", "Become Ussr Guy [HD ADMIN]", "Ban Hammer", "SpiderBot", "Lua Hammer",
	"Clone", "Create NPC", "Fake Character", "Special Thing [Hand]", "Infiltration", "Swim in Air",
	"Red Fire Player", "Normal Fire Player", "Orange Fire Player", "Black Fire Player", "Gray Fire Player", "Keyboard",
	"UnFire Player", "2sp00ks Decally Face", "Pumpkin Decally Face", "Selim Dede Decally Face", "PINGU Decally Face", "Szemtelen Mano Decally Face"
}

local function createButton(name)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSans
	btn.TextWrapped = true
	btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	btn.BorderColor3 = Color3.fromRGB(255, 69, 0)
	btn.BorderSizePixel = 2
	btn.Parent = scrollFrame

	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
		btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		task.wait(0.1)
		btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

for _, name in ipairs(buttonList) do 
	createButton(name) 
end

scrollFrame:FindFirstChild("Head Shake").MouseButton1Click:Connect(function() local Player = game.Players.LocalPlayer; local Character = Player.Character or Player.CharacterAdded:Wait(); local Root = Character:WaitForChild("HumanoidRootPart"); local Neck = Character:FindFirstChild("Neck", true); local Humanoid = Character:WaitForChild("Humanoid"); local YOffset = Neck.C0.Y; local XOffset = Neck.C0.X; local ZOffset = Neck.C0.Z; local CFNew = CFrame.new; local sin = math.sin; local clock = os.clock; local distance = 0.8; local speed = 6; game:GetService("RunService").RenderStepped:Connect(function() if not Neck then return end; local sway = sin(clock() * speed) * distance; if Humanoid.RigType == Enum.HumanoidRigType.R15 then Neck.C0 = CFNew(XOffset + sway, YOffset, ZOffset) elseif Humanoid.RigType == Enum.HumanoidRigType.R6 then Neck.C0 = CFNew(XOffset + sway, YOffset, ZOffset) * CFrame.Angles(3 * math.pi / 2, 0, math.pi) end end) end)
scrollFrame:FindFirstChild("Mesh Disco").MouseButton1Click:Connect(function() local plr = game.Players.LocalPlayer; local char = plr.Character or plr.CharacterAdded:Wait(); local meshes = {"Brick", "Cylinder", "Head", "Sphere", "Torso", "Wedge"}; local function applyMeshDisco() for _, v in pairs(char:GetChildren()) do if v:IsA("Part") and v.Name ~= "HumanoidRootPart" then local existingMesh = v:FindFirstChildOfClass("SpecialMesh"); if existingMesh then existingMesh:Destroy() end; local mesh = Instance.new("SpecialMesh", v); mesh.MeshType = meshes[math.random(1, #meshes)]; coroutine.wrap(function() while mesh and mesh.Parent do v.Color = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255)); task.wait(0.1) end end)() end end end; applyMeshDisco() end)
scrollFrame:FindFirstChild("Armless").MouseButton1Click:Connect(function() local Players = game:GetService("Players"); local localPlayer = Players.LocalPlayer; local character = localPlayer.Character or localPlayer.CharacterAdded:Wait(); local leftArmR6 = character:WaitForChild("Left Arm", 2); local rightArmR6 = character:WaitForChild("Right Arm", 2); if leftArmR6 and rightArmR6 then leftArmR6:Destroy(); rightArmR6:Destroy() else for _, partName in ipairs({"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand"}) do local part = character:FindFirstChild(partName); if part then part:Destroy() end end end; script:Destroy() end)
scrollFrame:FindFirstChild("Plane Arms").MouseButton1Click:Connect(function() local Players = game:GetService("Players"); local localPlayer = Players.LocalPlayer; local character = localPlayer.Character or localPlayer.CharacterAdded:Wait(); local leftArmR6 = character:WaitForChild("Left Arm", 2); local rightArmR6 = character:WaitForChild("Right Arm", 2); if leftArmR6 and rightArmR6 then leftArmR6:Destroy(); rightArmR6:Destroy() end; local torso = character:WaitForChild("Torso", 2); if torso then local mesh = Instance.new("SpecialMesh"); mesh.MeshType = Enum.MeshType.FileMesh; mesh.MeshId = "rbxassetid://5789412321"; mesh.TextureId = "rbxassetid://5789412365"; mesh.Scale = Vector3.new(0.15, 0.15, 0.15); mesh.Parent = torso end; script:Destroy() end)
