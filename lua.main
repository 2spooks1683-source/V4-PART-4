scrollFrame:FindFirstChild("Barrier For Torso").MouseButton1Click:Connect(function() local Players = game:GetService("Players"); local player = Players.LocalPlayer; local character = player.Character or player.CharacterAdded:Wait(); local torso = character:WaitForChild("Torso", 2) or character:WaitForChild("UpperTorso", 2); local humanoid = character:WaitForChild("Humanoid"); if not torso then return end; local MESH_ID = "rbxassetid://448864782"; local TEXTURE_ID = "rbxassetid://448864789"; local SHIELD_SCALE = Vector3.new(0.03, 0.03, 0.03); local DISTANCE = 1.2; local function createShield(name, offsetCFrame) local shieldPart = Instance.new("Part"); shieldPart.Name = name; shieldPart.Size = Vector3.new(2, 2, 0.5); shieldPart.CanCollide = false; shieldPart.Massless = true; shieldPart.Parent = character; local shieldMesh = Instance.new("SpecialMesh"); shieldMesh.MeshId = MESH_ID; shieldMesh.TextureId = TEXTURE_ID; shieldMesh.Scale = SHIELD_SCALE; shieldMesh.Parent = shieldPart; local weld = Instance.new("Weld"); weld.Part0 = torso; weld.Part1 = shieldPart; weld.C0 = offsetCFrame; weld.Parent = shieldPart; local handle = Instance.new("Part"); handle.Name = name .. "_Handle"; handle.Shape = Enum.PartType.Cylinder; handle.Size = Vector3.new(DISTANCE, 0.2, 0.2); handle.Color = Color3.fromRGB(255, 255, 255); handle.Material = Enum.Material.SmoothPlastic; handle.CanCollide = false; handle.Massless = true; handle.Parent = character; local handleWeld = Instance.new("Weld"); handleWeld.Part0 = torso; handleWeld.Part1 = handle; handleWeld.C0 = offsetCFrame * CFrame.new(0, 0, DISTANCE / 2) * CFrame.Angles(0, math.rad(90), 0); handleWeld.Parent = handle; shieldPart.Touched:Connect(function(hit) local otherCharacter = hit.Parent; if otherCharacter and otherCharacter ~= character then local otherHumanoid = otherCharacter:FindFirstChildOfClass("Humanoid"); local targetRoot = otherCharacter:FindFirstChild("HumanoidRootPart"); if otherHumanoid and targetRoot then local knockbackDirection = (targetRoot.Position - torso.Position).Unit; local bodyVelocity = Instance.new("BodyVelocity"); bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5); bodyVelocity.Velocity = knockbackDirection * 50 + Vector3.new(0, 20, 0); bodyVelocity.Parent = targetRoot; game:GetService("Debris"):AddItem(bodyVelocity, 0.2) end end end); return shieldPart end; createShield("FrontShield", CFrame.new(0, 0, -DISTANCE)); createShield("BackShield", CFrame.new(0, 0, DISTANCE) * CFrame.Angles(0, math.rad(180), 0)); humanoid.HealthChanged:Connect(function(health) if health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end end) end)
